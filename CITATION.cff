    given-names: Abhinaba
    email: abhinabaroy1990@gmail.com
    affiliation: "AMAAI Lab, Singapore University of Technology and Design"
repository-code: "https://github.com/AMAAI-Lab/musegauge"
url: "https://github.com/AMAAI-Lab/musegauge"
license: Apache-2.0
version: 0.1.4
date-released: 2026-10-18
keywords:
  - music generation
  - evaluation
  - Frechet Audio Distance
  - CLAP
